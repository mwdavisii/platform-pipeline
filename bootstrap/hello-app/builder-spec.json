{
  "app_name": "hello-app",
  "app_type": "python",
  "authz": {
    "default": "deny",
    "roles": [
      {
        "access": "read",
        "name": "reader"
      },
      {
        "access": "write",
        "name": "writer"
      }
    ],
    "rules": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/**",
        "roles": [
          "reader",
          "writer"
        ]
      },
      {
        "methods": [
          "DELETE",
          "PATCH",
          "POST",
          "PUT"
        ],
        "path": "/api/**",
        "roles": [
          "writer"
        ]
      }
    ]
  },
  "data_classification": "confidential",
  "egress": [
    {
      "host": "llm.mwdavisii.com",
      "port": 443,
      "reason": "model calls through the platform gateway"
    }
  ],
  "entrypoint": "app:app",
  "env": [],
  "health_path": "/healthz",
  "port": 8080,
  "resources_tier": "default",
  "server": "uvicorn"
}
