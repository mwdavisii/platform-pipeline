{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.internal/schemas/agent-batch.v1.json",
  "title": "agent-batch/v1",
  "description": "What the review agent submits for one batch of requirements (the submit_assessment tool's arguments). Self-contained (local $defs only) so it can be sent to the model as the tool's parameter schema. Code adds the finding IDs, sources, and timestamps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["results", "findings"],
  "properties": {
    "results": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/result"}},
    "findings": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asvs_id", "status", "confidence", "justification", "evidence", "finding_refs"],
      "properties": {
        "asvs_id": {"type": "string", "pattern": "^v5\\.0\\.0-[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
        "status": {"enum": ["pass", "fail", "na", "needs_human"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "justification": {"type": "string", "maxLength": 4000},
        "evidence": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/anchor"}},
        "finding_refs": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "rule_id", "category", "severity", "confidence", "location", "evidence", "title", "rationale", "fix", "standards"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:-]{0,99}$"},
        "category": {"enum": ["authz", "harness", "data-handling", "egress", "test-integrity", "scope", "injection"]},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "file"],
          "properties": {
            "kind": {"enum": ["line", "file", "absence"]},
            "file": {"$ref": "#/$defs/repo_path", "maxLength": 1024},
            "start_line": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "end_line": {"type": "integer", "minimum": 1, "maximum": 2147483647}
          },
          "if": {"properties": {"kind": {"const": "line"}}, "required": ["kind"]},
          "then": {"required": ["start_line"]}
        },
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/anchor"}},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 8000},
        "fix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "steps"],
          "properties": {
            "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
            "steps": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 2000}}
          }
        },
        "standards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["framework", "id"],
            "properties": {
              "framework": {"enum": ["asvs-5.0", "golden-road-vc", "cwe", "owasp-llm-2025", "owasp-api-2023"]},
              "id": {"type": "string", "minLength": 1, "maxLength": 100}
            },
            "allOf": [
              {"if": {"properties": {"framework": {"const": "cwe"}}, "required": ["framework"]},
               "then": {"properties": {"id": {"pattern": "^CWE-[1-9][0-9]*$"}}}},
              {"if": {"properties": {"framework": {"const": "golden-road-vc"}}, "required": ["framework"]},
               "then": {"properties": {"id": {"enum": ["VC-1", "VC-2", "VC-4", "VC-5", "VC-6", "VC-INJ"]}}}}
            ]
          },
          "allOf": [
            {"anyOf": [{"contains": {"properties": {"framework": {"const": "golden-road-vc"}}}},
                       {"contains": {"properties": {"framework": {"const": "cwe"}}}}]},
            {"anyOf": [{"contains": {"properties": {"framework": {"enum": ["golden-road-vc", "asvs-5.0", "owasp-llm-2025", "owasp-api-2023"]}}}}]}
          ]
        }
      }
    },
    "ref": {"type": "string", "pattern": "^F[1-9][0-9]{0,2}$"},
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "start_line", "snippet"],
      "properties": {
        "file": {"$ref": "#/$defs/repo_path", "maxLength": 1024},
        "start_line": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "snippet": {"type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S"},
        "note": {"type": "string", "maxLength": 2000}
      }
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        {"const": "<unknown>"},
        {"allOf": [
          {"not": {"pattern": "[\\x00-\\x1f\\x7f\\x85\\u2028\\u2029]"}},
          {"not": {"pattern": "\\\\"}},
          {"not": {"pattern": "^/"}},
          {"not": {"pattern": "(^|/)\\.\\.(/|$)"}},
          {"not": {"pattern": "(^|/)\\.(/|$)"}},
          {"not": {"pattern": "(^|/)\\.git(/|$)"}}
        ]}
      ]
    }
  }
}
