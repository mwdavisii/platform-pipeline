{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.internal/schemas/agent.v1.json",
  "title": "agent/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "display_name",
    "model",
    "instructions"
  ],
  "properties": {
    "schema": {
      "const": "agent/v1"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029\\ud800-\\udfff]"
      }
    },
    "model": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029\\ud800-\\udfff]"
      }
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\x00-\\x08\\x0b-\\x1f\\x7f-\\x9f\\ud800-\\udfff]"
      }
    },
    "starters": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "\\S",
        "not": {
          "pattern": "[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029\\ud800-\\udfff]"
        }
      }
    }
  }
}
