{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.internal/schemas/builder-guide.v1.json",
  "title": "builder-guide/v1",
  "description": "The spec fields and rules of one builder version, for a coding agent. Printed by `builder guide`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["builder_version", "platform_config_sha256", "model_gateway_hosts", "fields", "reserved_env", "never_edit", "managed_blocks", "rules", "exit_codes"],
  "properties": {
    "builder_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "platform_config_sha256": {"$ref": "#/$defs/sha256"},
    "model_gateway_hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "type", "required", "decided_by", "rules"],
        "properties": {
          "field": {"type": "string", "pattern": "^[a-z_]+(\\[\\])?(\\.[a-z_]+(\\[\\])?)*$"},
          "type": {"enum": ["string", "integer", "boolean", "array", "object"]},
          "required": {"type": "boolean"},
          "decided_by": {"enum": ["user", "agent"]},
          "rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "enum": {"type": "array", "minItems": 1},
          "const": {},
          "pattern": {"type": "string"},
          "minimum": {"type": "integer"},
          "maximum": {"type": "integer"},
          "minLength": {"type": "integer"},
          "maxLength": {"type": "integer"},
          "minItems": {"type": "integer"},
          "uniqueItems": {"type": "boolean"},
          "items": {"type": "object"}
        }
      }
    },
    "reserved_env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "prefixes"],
      "properties": {
        "names": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "prefixes": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "never_edit": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "managed_blocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "begin", "end"],
      "properties": {
        "files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "begin": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "text": {"type": "string", "minLength": 1}}
      }
    },
    "exit_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detect", "generate", "verify", "guide"],
      "properties": {"detect": {"$ref": "#/$defs/codes"}, "generate": {"$ref": "#/$defs/codes"}, "verify": {"$ref": "#/$defs/codes"}, "guide": {"$ref": "#/$defs/codes"}}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "codes": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[0-9]$"}, "additionalProperties": {"type": "string", "minLength": 1}}
  }
}
