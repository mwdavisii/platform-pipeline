{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.internal/schemas/cloudflare-access.v1.json",
  "title": "cloudflare-access/v1",
  "description": "apps/<owner>/<repo>/<env>/cloudflare-access.yaml in golden-road-deploy, generated by golden-road compose from bindings.yaml's mcp: the desired state a platform job (documented, not built) reconciles into Cloudflare. Issue the service token if missing, store it in Secret Server at token.secret_path, and make each listed server's Service Auth policy name it. Never a credential.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "repo", "environment", "gateway", "token", "servers"],
  "$defs": {"single_line": {"not": {"pattern": "[\\r\\n]"}}},
  "properties": {
    "schema": {"const": "cloudflare-access/v1"},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "allOf": [{"$ref": "#/$defs/single_line"}]},
    "environment": {"enum": ["test", "prod"]},
    "gateway": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$", "allOf": [{"$ref": "#/$defs/single_line"}]},
    "token": {"type": "object", "additionalProperties": false, "required": ["name", "secret_path"],
              "properties": {"name": {"type": "string", "pattern": "^cf-mcp-[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9])){0,38}--[a-z0-9._-]{1,100}-(test|prod)$", "allOf": [{"$ref": "#/$defs/single_line"}]},
                             "secret_path": {"type": "string", "pattern": "^/golden-road/mcp-tokens/cf-mcp-[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9])){0,38}--[a-z0-9._-]{1,100}-(test|prod)$", "allOf": [{"$ref": "#/$defs/single_line"}]}}},
    "servers": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$", "allOf": [{"$ref": "#/$defs/single_line"}]}}
  }
}
