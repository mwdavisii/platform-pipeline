{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.internal/schemas/finding.v1.json",
  "title": "finding/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "rule_id", "category", "severity", "confidence", "location", "evidence", "evidence_verified", "title", "rationale", "fix", "standards"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "tool"],
      "properties": {
        "layer": {"enum": ["deterministic", "agentic", "drift", "dynamic"]},
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string"}
      }
    },
    "rule_id": {"type": "string", "minLength": 1},
    "category": {"enum": ["secrets", "sast", "sca", "license", "image", "iac", "drift", "egress", "authz", "harness", "data-handling", "dependency"]},
    "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file"],
      "properties": {
        "kind": {"enum": ["line", "file", "absence"]},
        "file": {"$ref": "#/$defs/repo_path"},
        "start_line": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "end_line": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      },
      "if": {"properties": {"kind": {"const": "line"}}, "required": ["kind"]},
      "then": {"required": ["start_line"]}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "start_line", "snippet"],
        "properties": {
          "file": {"$ref": "#/$defs/repo_path"},
          "start_line": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "snippet": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "note": {"type": "string"}
        }
      }
    },
    "evidence_verified": {"type": "boolean"},
    "title": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "steps"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "items": {"type": "string"}},
        "patch": {"type": "string"}
      }
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "id"],
        "properties": {
          "framework": {"enum": ["cwe", "asvs-5.0", "owasp-api-2023", "owasp-llm-2025", "cvss", "epss", "nist-ssdf", "slsa", "pss", "cis-k8s", "hipaa"]},
          "id": {"type": "string", "minLength": 1}
        },
        "if": {"properties": {"framework": {"const": "cwe"}}, "required": ["framework"]},
        "then": {"properties": {"id": {"pattern": "^CWE-[1-9][0-9]*$"}}}
      },
      "contains": {"properties": {"framework": {"const": "cwe"}}}
    }
  },
  "if": {"properties": {"source": {"properties": {"layer": {"const": "agentic"}}}}},
  "then": {
    "properties": {
      "standards": {"contains": {"properties": {"framework": {"enum": ["asvs-5.0", "owasp-api-2023", "owasp-llm-2025"]}}}}
    }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        {"const": "<unknown>"},
        {"allOf": [
          {"not": {"pattern": "[\\x00-\\x1f\\x7f\\x85\\u2028\\u2029]"}},
          {"not": {"pattern": "\\\\"}},
          {"not": {"pattern": "^/"}},
          {"not": {"pattern": "(^|/)\\.\\.(/|$)"}},
          {"not": {"pattern": "(^|/)\\.(/|$)"}}
        ]}
      ]
    }
  }
}
