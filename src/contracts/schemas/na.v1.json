{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.internal/schemas/na.v1.json",
  "title": "na/v1",
  "description": "The factory's na/<owner>/<repo>.yaml: ASVS requirements a human confirmed are not applicable to this app.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repo", "entries"],
  "properties": {
    "schema": {"const": "na/v1"},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["asvs_id", "justification", "confirmed_by", "confirmed"],
        "properties": {
          "asvs_id": {"type": "string", "pattern": "^v5\\.0\\.0-[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
          "justification": {"type": "string", "minLength": 10, "not": {"pattern": "[\\r\\n]"}},
          "confirmed_by": {"type": "string", "minLength": 1, "not": {"pattern": "[\\r\\n]"}},
          "confirmed": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
