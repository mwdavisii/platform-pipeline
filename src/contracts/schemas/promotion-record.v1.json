{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.internal/schemas/promotion-record.v1.json",
  "title": "promotion-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "image",
    "approvals",
    "self_approved",
    "gate2_single_approver",
    "triggered_by",
    "actor",
    "run_attempt",
    "run_url",
    "manifests_sha256",
    "created"
  ],
  "properties": {
    "schema": {
      "const": "promotion-record/v1"
    },
    "release": {
      "type": "string",
      "pattern": "^test-[0-9]{14}-[0-9a-f]{7}$",
      "maxLength": 30,
      "allOf": [
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ]
    },
    "image": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ]
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "login",
          "comment"
        ],
        "properties": {
          "login": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 100,
            "allOf": [
              {
                "not": {
                  "pattern": "[\\r\\n]"
                }
              }
            ]
          },
          "comment": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "triggered_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\[\\]-]+$",
      "maxLength": 100,
      "allOf": [
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ]
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_\\[\\]-]+$",
      "maxLength": 100,
      "allOf": [
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ]
    },
    "run_attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "run_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 300,
      "allOf": [
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ]
    },
    "manifests_sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ],
      "minLength": 64
    },
    "created": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "allOf": [
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ]
    },
    "self_approved": {
      "type": "boolean",
      "description": "True only when every counted approver is the person who triggered the run (single-approver PoC mode)."
    },
    "gate2_single_approver": {
      "type": "boolean",
      "description": "The platform's gate2_single_approver flag when the record was made. self_approved and this field were added to v1 before the first proof run, so earlier v1 records are invalid."
    }
  }
}
