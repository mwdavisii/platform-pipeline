{
  "app_name": "notes-node",
  "app_type": "node",
  "authz": {
    "default": "deny",
    "roles": [
      {
        "access": "read",
        "name": "reader"
      },
      {
        "access": "write",
        "name": "writer"
      }
    ],
    "rules": [
      {
        "methods": [
          "GET"
        ],
        "path": "/api/**",
        "roles": [
          "reader",
          "writer"
        ]
      },
      {
        "methods": [
          "DELETE",
          "PATCH",
          "POST",
          "PUT"
        ],
        "path": "/api/**",
        "roles": [
          "writer"
        ]
      }
    ]
  },
  "data_classification": "internal",
  "egress": [],
  "entrypoint": "server.js",
  "env": [],
  "health_path": "/healthz",
  "port": 8080,
  "resources_tier": "default"
}
